local jumpSlider=movement:Slider("Jump power",30,150,80,function(v) app.jumpPower=v; setConfig("jumpPower",v) end,1)
app.controls.infinite=movement:Toggle("Infinite jump",function(on) app.infiniteJump=on; setConfig("infiniteJump",on) end,false)
local settings=win:Folder("Settings")
local status=settings:Section("STATUS")
app.statusLabel=status:Label("Status: Ready")
status:Label(configAvailable and "Config: automatic saving enabled" or "Config: executor file access unavailable")
status:Label("Right Shift shows or hides the menu.")
local controls=settings:Section("CONTROLS")
controls:Button("Save Config",function() if not configAvailable then report("Config unavailable") elseif saveConfig(true) then report("Config saved") end end)
controls:Button("Stop All",function() app:StopAll() end)
controls:Button("Unload",function() app:Unload() end)
-- Restore only validated values after every control and adapter is ready.
app.flySpeed=config.flySpeed; app.walkSpeed=config.walkSpeed; app.jumpPower=config.jumpPower
flySlider:Set(app.flySpeed); walkSlider:Set(app.walkSpeed); jumpSlider:Set(app.jumpPower)
if config.unlock then
    app:SetUnlock(true)
    local modes={SpawnMode=true,LaunchMode=true,ExplodeMode=true,HealMode=true,DeleteMode=true,BarrelMode=true}
    for _,key in ipairs({"SlowMotion","FreezeTime","FreeCamera","Fly","GrabMode","ScanMode","RunSpeed","Gravity",
        "SpawnMode","LaunchMode","ExplodeMode","HealMode","DeleteMode","BarrelMode"}) do
        local value=config.lab[key]
        local valid=(type(value)=="boolean" and key~="RunSpeed" and key~="Gravity") or
            (type(value)=="number" and value==value and key=="RunSpeed" and value>=8 and value<=60) or
            (type(value)=="number" and value==value and key=="Gravity" and value>=10 and value<=200)
        if valid then
            if modes[key] and value then app.mode=key end
            link.value(key); pcall(link.set,key,value)
        end
    end
end
if config.fly then app:SetFly(true) end
if config.noclip then app:SetNoclip(true) end
if config.speed then app:SetSpeed(true) end
if config.jump then app:SetJump(true) end
app.infiniteJump=config.infiniteJump
restoreIdentity()
for key,control in pairs(app.controls) do
    local value=config[key=="infinite" and "infiniteJump" or key]
    control:Set(value==true)
end
app.restoring=false
win:Notify("Ready  |  Right Shift toggles the menu",4)
refreshNative()
