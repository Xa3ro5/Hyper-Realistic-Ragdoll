local seenContainers={}
local function removeStale(container)
    if not container or seenContainers[container] then return end
    seenContainers[container]=true
    pcall(function()
        for _,gui in ipairs(container:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name=="SmugLibCore" then
                for _,item in ipairs(gui:GetDescendants()) do
                    if item:IsA("TextLabel") and (item.Text=="SMUG  |  HYPER RAGDOLL" or item.Text=="SMUG / Hyper Realistic Ragdoll") then
                        gui:Destroy(); break
                    end
                end
            end
        end
    end)
end
