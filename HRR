    ExplodeMode=true,HealMode=true,DeleteMode=true,BarrelMode=true,GrabMode=true,ScanMode=true,RunSpeed=true,Gravity=true}
local savedVehiclePasses={}
local function setVehiclesUnlocked(enabled)
    for _,key in ipairs(vehicleConfig.Order) do
        local row=vehicleConfig.Rows[key]
        if row then
            if enabled then
                if row.pass and not savedVehiclePasses[key] then savedVehiclePasses[key]=row.pass end
                if savedVehiclePasses[key] then row.pass=nil end
            elseif savedVehiclePasses[key] then
                if row.pass==nil then row.pass=savedVehiclePasses[key] end
                savedVehiclePasses[key]=nil
            end
            local vehicle=vehicles.get(key)
            if vehicle and vehicle.prompt and row.prompt then
                local passes=root.Fusion.peek(state.Session).Passes or {}
                local owned=not row.pass
                for _,pass in ipairs(row.pass or {}) do if passes[pass] then owned=true end end
                vehicle.prompt.ActionText=owned and row.prompt.action or "Unlock"
            end
        end
    end
end
local actionDisconnect=actions.on("Sandbox",function(change)
