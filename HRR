local config=table.clone(configDefaults)
config.lab={}
local configAvailable=type(readfile)=="function" and type(writefile)=="function"
if configAvailable then
    local readOk,data=pcall(readfile,configPath)
    if readOk and type(data)=="string" then
        local decodeOk,saved=pcall(HttpService.JSONDecode,HttpService,data)
        if decodeOk and type(saved)=="table" then
            for _,key in ipairs({"unlock","fly","noclip","speed","jump","infiniteJump"}) do
                if type(saved[key])=="boolean" then config[key]=saved[key] end
            end
            for key,limits in pairs({flySpeed={10,200},walkSpeed={8,100},jumpPower={30,150}}) do
                local value=tonumber(saved[key])
                if value and value==value and value~=math.huge and value~=-math.huge then config[key]=math.clamp(value,limits[1],limits[2]) end
            end
            if type(saved.loadout)=="table" then config.loadout=saved.loadout end
            if type(saved.lab)=="table" then config.lab=saved.lab end
        end
    end
end
