local function findTools(container,key)
    local found={}
    if container then for _,item in ipairs(container:GetChildren()) do
        if item:IsA("Tool") and item:GetAttribute("ToolKey")==key then table.insert(found,item) end
    end end
    return found
end
function app:ReconcileTools()
    if not self.enabled then return end
    local backpack=player:FindFirstChildOfClass("Backpack")
    local char=player.Character
    if not backpack then return end
    local selected={}
    for _,key in ipairs(self.localLoadout) do selected[key]=true end
    for _,container in ipairs({backpack,char}) do
        if container then for _,item in ipairs(container:GetChildren()) do
            local key=item:IsA("Tool") and item:GetAttribute("ToolKey")
            if key and allTools[key] and not selected[key] then
                if item:GetAttribute("SmugHRRTemporary") then item:Destroy()
                else item.Parent=self.stash end
            end
        end end
    end
    for _,key in ipairs(self.localLoadout) do
        local active=findTools(backpack,key)
        for _,v in ipairs(findTools(char,key)) do table.insert(active,v) end
        if #active==0 then
            local stashed=findTools(self.stash,key)[1]
            if stashed then stashed.Parent=backpack else
                local template=templates:FindFirstChild(key)
                if template and template:IsA("Tool") and template:GetAttribute("ToolKey")==key then
                    local copy=template:Clone()
                    copy:SetAttribute("SmugHRRTemporary",true)
                    copy.Parent=backpack
                    table.insert(self.clones,copy)
                end
            end
        end
    end
end
wrappers.setEquipped=function(key,on)
    if not app.enabled then return original.setEquipped(key,on) end
    if not allTools[key] then report("Tool template is unavailable"); return false end
    local index=table.find(app.localLoadout,key)
    if on and not index then
        if #app.localLoadout>=state.MaxLoadout then
            report("Hotbar full; unequip another tool first")
            local kit=client.UI:FindFirstChild("Kit")
            if kit then pcall(function() require(kit.Toast).show("Your hotbar is full. Unequip a tool first.","Bad") end) end
            return false
        end
        table.insert(app.localLoadout,key)
    elseif not on and index then table.remove(app.localLoadout,index) end
    app:ReconcileTools()
    config.loadout=table.clone(app.localLoadout)
    saveConfig(false)
    changed()
    report((on and "Added to hotbar: " or "Removed from hotbar: ")..key)
    return true
end
