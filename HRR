local saveGeneration=0
local function saveConfig(immediate)
    if app.restoring or app.suppressSave or not configAvailable then return end
    saveGeneration+=1
    local generation=saveGeneration
    local function write()
        if not immediate and generation~=saveGeneration then return end
        local ok,encoded=pcall(HttpService.JSONEncode,HttpService,config)
        if not ok then app.configError=tostring(encoded); report("Config encoding failed"); return false end
        local written,err=pcall(writefile,configPath,encoded)
        if not written then app.configError=tostring(err); report("Config save failed: "..tostring(err)); return false end
        app.configError=nil
        return true
    end
    if immediate then return write() else task.delay(0.35,write) end
end
