function app:RemoveTools()
    for _,tool in ipairs(self.clones) do if tool.Parent then tool:Destroy() end end
    table.clear(self.clones)
    if self.stash then
        local backpack=player:FindFirstChildOfClass("Backpack")
        if backpack then
            for _,tool in ipairs(self.stash:GetChildren()) do if tool:IsA("Tool") then tool.Parent=backpack end end
        elseif not self.restorePending then
            self.restorePending=true
            local pendingStash=self.stash
            task.spawn(function()
                local nextBackpack=player:WaitForChild("Backpack",30)
                self.restorePending=false
                if nextBackpack and self.stash==pendingStash and not self.enabled then self:RemoveTools() end
            end)
        end
        if #self.stash:GetChildren()==0 then self.stash:Destroy(); self.stash=nil end
    end
end
function app:SetUnlock(on)
    if self.enabled==on then return end
    if on then
        self.localLoadout={}
        local requested=type(config.loadout)=="table" and config.loadout or root.Fusion.peek(state.Loadout)
        for _,key in ipairs(requested) do
            if type(key)=="string" and allTools[key] and not table.find(self.localLoadout,key) and #self.localLoadout<state.MaxLoadout then
                table.insert(self.localLoadout,key)
            end
        end
        if not self.stash then
            self.stash=Instance.new("Folder")
            self.stash.Name="SmugHRRStash"
            self.stash.Parent=player:WaitForChild("PlayerScripts")
        end
        self.labBefore={}
        for _,key in ipairs(labKeys) do
            local value=link.value(key)
            if not value then value=link.value(key) end
            self.labBefore[key]=value and root.Fusion.peek(value)==true or false
        end
        self.enabled=true
        setVehiclesUnlocked(true)
        self:ReconcileTools()
        changed(); refreshNative()
        report("Tools, Lab, events and vehicles unlocked locally")
        setConfig("unlock",true)
    else
        self.enabled=false
        setVehiclesUnlocked(false)
        for _,key in ipairs(labKeys) do
            local value=link.value(key)
            if value and root.Fusion.peek(value) and not self.labBefore[key] then pcall(link.set,key,false) end
        end
        self:RemoveTools()
        self.mode=nil; self.freeze=false; self.localLoadout=nil
        changed(); refreshNative()
        report("Local access disabled")
        setConfig("unlock",false)
    end
end
function app:SetMode(mode)
    if self.mode then pcall(link.set,self.mode,false) end
    self.mode=nil
    if mode and self.enabled then
        link.value(mode)
        local worked, err=pcall(link.set,mode,true)
        if worked then self.mode=mode; report("Lab: "..mode.." - click in the world") else report("Lab error: "..tostring(err)) end
    elseif mode then report("Enable Unlock All first") end
    for key, control in pairs(self.modeControls or {}) do pcall(function() control:Set(key==self.mode) end) end
end
function app:SetFreeze(on)
    if on and not self.enabled then report("Enable Unlock All first"); return false end
    if on and not self.freeze then self.freezeBefore=freeze.isFrozen() end
    if not on and not self.freeze then return false end
    link.value("FreezeTime")
    local wanted=on or self.freezeBefore==true
    local worked,err=pcall(link.set,"FreezeTime",wanted)
    if worked then self.freeze=on; report(on and "Time frozen" or "Time resumed") else report("Stop time: "..tostring(err)) end
    return worked and on
end
function app:SetFly(on)
    self.fly=on
    if not on then destroyFly(); report("Flight disabled") else report("Flight enabled: WASD follows the camera") end
end
function app:SetNoclip(on)
    self.noclip=on
    if not on then resetCollision() end
end
function app:SetSpeed(on)
    local _,hum=getChar(); capture(hum)
    if on and not self.speed then
        local speedValue=link.value("RunSpeed")
        if not speedValue then speedValue=link.value("RunSpeed") end
        self.oldRunSpeed=speedValue and root.Fusion.peek(speedValue) or 16
    end
    self.speed=on
    link.value("RunSpeed")
    local worked,err=pcall(link.set,"RunSpeed",on and self.walkSpeed or (self.oldRunSpeed or 16))
    if not worked then report("Speed: "..tostring(err)) end
end
function app:SetJump(on)
    local _,hum=getChar(); capture(hum)
    self.jump=on
    local saved=self.savedHumanoid
    if hum and saved and saved.hum==hum then
        if on then
            if hum.UseJumpPower then hum.JumpPower=self.jumpPower else hum.JumpHeight=self.jumpPower*self.jumpPower/(2*workspace.Gravity) end
        else hum.JumpPower=saved.jumpPower; hum.JumpHeight=saved.jumpHeight end
    end
end
function app:StopAll()
    self.eventCancelled=true
    if self.eventStarted and runner.active()==self.eventStarted then pcall(runner.stop) end
    self:SetMode(nil); self:SetFreeze(false); self:SetFly(false); self:SetNoclip(false)
    if self.speed then self:SetSpeed(false) end
    self:SetJump(false); self.infiniteJump=false
    if self.enabled then self:SetUnlock(false) else self:RemoveTools() end
    for _,control in pairs(self.controls) do pcall(function() control:Set(false) end) end
    for _,key in ipairs({"unlock","fly","noclip","speed","jump","infiniteJump"}) do config[key]=false end
    saveConfig(false)
    report("All features stopped")
end
function app:Unload()
    if not self.alive then return end
    saveConfig(true)
    self.suppressSave=true
    self:StopAll(); self.alive=false
    if actionDisconnect then actionDisconnect(); actionDisconnect=nil end
    if eventRules.unlimited==unlimitedWrapper then eventRules.unlimited=original.unlimited end
    for key,wrapper in pairs(wrappers) do if state[key]==wrapper then state[key]=original[key] end end
    if state.Permanent==permanentProxy then state.Permanent=original.permanent end
    refreshNative()
    for _,c in ipairs(self.connections) do c:Disconnect() end
    table.clear(self.connections)
    if self.window then local w=self.window; self.window=nil; restoreIdentity(); pcall(function() w:Kill() end) end
    if env.SmugHRR==self then env.SmugHRR=nil end
end
